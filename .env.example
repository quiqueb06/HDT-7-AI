# Llave de Groq (tier gratuito) para el SDK de agentes
GROQ_API_KEY=
BASE_URL=https://api.groq.com/openai/v1
PARACHUTE_MODEL=openai/gpt-oss-20b    # modelo usado por todos los agentes

# Opcionales
PARACHUTE_WEATHER_MODE=live           # "live" (Open-Meteo real) o "mock" (datos simulados)
PARACHUTE_APPOINTMENTS_FILE=data/citas.json
MCP_URL=http://127.0.0.1:8001/mcp     # servidor MCP al que se conectan los agentes
A2A_URL=http://127.0.0.1:9999         # servidor A2A al que se conecta la terminal
